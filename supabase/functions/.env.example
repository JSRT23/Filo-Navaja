# Secretos de las Edge Functions.
# Local:      copia este archivo a supabase/functions/.env  y corre  supabase functions serve --env-file supabase/functions/.env
# Producción: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase; no los pongas aquí.)

# Correo transaccional con Resend (https://resend.com). Si se deja vacío, los correos solo se registran en el log.
RESEND_API_KEY=
EMAIL_FROM="Filo & Navaja <citas@filoynavaja.co>"

# URL pública del frontend (enlaces de los correos)
APP_URL=http://localhost:5173

# Origen permitido por CORS (en producción, el dominio del frontend)
ALLOWED_ORIGIN=*
